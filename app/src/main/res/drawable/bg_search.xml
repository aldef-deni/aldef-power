<?xml version="1.0" encoding="utf-8"?>
<!-- Kolom cari: tepi menyala ungu saat aktif -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#171A38" />
            <stroke
                android:width="1.5dp"
                android:color="@color/accent_violet" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="24dp" />
            <solid android:color="#12142B" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>
</selector>
