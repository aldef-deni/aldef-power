<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="Kembali"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="Aldef Remote"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/stateDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_icon_circle"
                        android:backgroundTint="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Belum terhubung"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnPickTv"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_round_btn"
                android:contentDescription="Pilih TV"
                android:padding="11dp"
                android:src="@drawable/ic_tv"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <!-- ================= Pilih TV ================= -->
        <LinearLayout
            android:id="@+id/connectPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:text="Pilih TV"
                            android:textColor="@color/text_primary"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/tvScan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Mencari Android TV di Wi-Fi yang sama…"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnRescan"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_round_btn"
                        android:contentDescription="Cari ulang"
                        android:padding="10dp"
                        android:src="@drawable/ic_refresh"
                        android:tint="@color/accent_light" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tvList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/btnManual"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_chip"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="Masukkan alamat IP TV manual"
                    android:textColor="@color/accent_light"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:lineSpacingExtra="4dp"
                android:padding="16dp"
                android:text="Cara menyambungkan:\n1. Nyalakan TV &amp; sambungkan HP ke Wi-Fi yang sama.\n2. Pilih TV di atas.\n3. Kode 6 karakter muncul di layar TV — ketik di HP.\nSetelah sekali pairing, remote langsung tersambung otomatis."
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ================= Remote ================= -->
        <LinearLayout
            android:id="@+id/remotePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnPower"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_remote_power"
                    android:contentDescription="Power TV"
                    android:elevation="6dp"
                    android:padding="15dp"
                    android:src="@drawable/ic_power"
                    android:tint="#FFFFFF" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/btnInput"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Sumber input"
                    android:padding="14dp"
                    android:src="@drawable/ic_input"
                    android:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnSettings"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Pengaturan TV"
                    android:padding="14dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Mode D-pad / Touchpad -->
            <LinearLayout
                android:layout_width="230dp"
                android:layout_height="42dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_tabs"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabDpad"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_dpad"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="10dp"
                    android:text="D-pad"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabTouch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:drawableStart="@drawable/ic_touchpad"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/text_primary"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="Touchpad"
                    android:textSize="13sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="14dp">

                <com.aldef.power.DpadView
                    android:id="@+id/dpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center" />

                <com.aldef.power.TouchpadView
                    android:id="@+id/touchpad"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Kembali / Home / Menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnKeyBack"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Kembali"
                    android:padding="17dp"
                    android:src="@drawable/ic_back"
                    android:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="34dp"
                    android:layout_marginEnd="34dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Home"
                    android:padding="16dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Menu"
                    android:padding="17dp"
                    android:src="@drawable/ic_menu"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Volume & Channel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:background="@drawable/bg_remote_pill"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnVolDown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_half"
                        android:contentDescription="Volume turun"
                        android:padding="16dp"
                        android:src="@drawable/ic_vol_down"
                        android:tint="@color/text_primary" />

                    <ImageView
                        android:id="@+id/btnMute"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_half"
                        android:contentDescription="Bisukan"
                        android:padding="17dp"
                        android:src="@drawable/ic_vol_mute"
                        android:tint="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/btnVolUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_half"
                        android:contentDescription="Volume naik"
                        android:padding="16dp"
                        android:src="@drawable/ic_vol_up"
                        android:tint="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_remote_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnChDown"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_half"
                        android:contentDescription="Channel turun"
                        android:padding="15dp"
                        android:src="@drawable/ic_ch_down"
                        android:tint="@color/text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.1"
                        android:text="CH"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <ImageView
                        android:id="@+id/btnChUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_half"
                        android:contentDescription="Channel naik"
                        android:padding="15dp"
                        android:src="@drawable/ic_ch_up"
                        android:tint="@color/text_primary" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Tombol volume HP juga mengatur volume TV"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Media -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnRewind"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Mundur"
                    android:padding="14dp"
                    android:src="@drawable/ic_rewind"
                    android:tint="@color/text_primary" />

                <ImageView
                    android:id="@+id/btnPlay"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="30dp"
                    android:layout_marginEnd="30dp"
                    android:background="@drawable/bg_btn_pill"
                    android:contentDescription="Putar / jeda"
                    android:elevation="6dp"
                    android:padding="19dp"
                    android:src="@drawable/ic_play_pause"
                    android:tint="#FFFFFF" />

                <ImageView
                    android:id="@+id/btnForward"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_remote_key"
                    android:contentDescription="Maju"
                    android:padding="14dp"
                    android:src="@drawable/ic_forward"
                    android:tint="@color/text_primary" />
            </LinearLayout>

            <!-- Aplikasi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.15"
                android:text="PINTASAN"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnKeyboard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:drawableStart="@drawable/ic_keyboard"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/accent_cyan"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="Keyboard"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/appYoutube"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:drawableStart="@drawable/ic_youtube"
                    android:drawablePadding="8dp"
                    android:drawableTint="#FF3B3B"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="YouTube"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
