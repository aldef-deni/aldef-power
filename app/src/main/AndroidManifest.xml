<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sembunyikan foto & video -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Selfie Penyusup -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.front"
        android:required="false" />
    <!-- Email Selfie Penyusup & Remote TV lewat Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Daftar aplikasi untuk disembunyikan -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar">

        <!-- Splash: hitam polos, lalu gambar ALDEF POWER + loading 3 detik -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <!-- Sembunyikan (footer 5x) & Ruang Privat (logo 5x) -->
        <activity
            android:name=".VaultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:theme="@style/Theme.AldefPower.Main" />

        <activity
            android:name=".PinActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <activity
            android:name=".FeaturesActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <!-- Remote TV (Android TV Remote v2 lewat Wi-Fi) -->
        <activity
            android:name=".RemoteActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <!-- Ulang kirim email Selfie Penyusup saat internet tersedia -->
        <service
            android:name=".IntruderMailJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <activity
            android:name=".IntruderLogActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <!-- Selfie Penyusup: transparan, muncul sesaat di atas layar kunci -->
        <activity
            android:name=".IntruderCaptureActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity="com.aldef.power.intruder"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Animasi cas neon: layar penuh, juga di atas layar kunci -->
        <activity
            android:name=".ChargingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:taskAffinity="com.aldef.power.charging"
            android:theme="@style/Theme.AldefPower.Viewer"
            android:turnScreenOn="true" />

        <activity
            android:name=".MediaViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.AldefPower.Viewer" />

        <!-- Activity transparan untuk shortcut & tile: Restart / Kunci / Menu Power -->
        <activity
            android:name=".QuickActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Metode 1: Aksesibilitas (tanpa root, tanpa PC) -->
        <service
            android:name=".RebootAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Mode Admin (Device Owner): untuk menyembunyikan aplikasi, diset sekali via ADB -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Tombol di panel notifikasi (Quick Settings) -->
        <service
            android:name=".RestartTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_restart"
            android:label="@string/tile_restart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
