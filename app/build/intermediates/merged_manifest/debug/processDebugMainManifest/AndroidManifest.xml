<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.aldef.power"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <!-- Sembunyikan foto & video -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Daftar aplikasi untuk disembunyikan -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light.DarkActionBar" >

        <!-- Splash: hitam polos, lalu gambar ALDEF POWER + loading 3 detik -->
        <activity
            android:name="com.aldef.power.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name="com.aldef.power.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main" />

        <!-- Sembunyikan (footer 5x) & Ruang Privat (logo 5x) -->
        <activity
            android:name="com.aldef.power.VaultActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AldefPower.Main"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name="com.aldef.power.MediaViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.AldefPower.Viewer" />

        <!-- Activity transparan untuk shortcut & tile: Restart / Kunci / Menu Power -->
        <activity
            android:name="com.aldef.power.QuickActionActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Metode 1: Aksesibilitas (tanpa root, tanpa PC) -->
        <service
            android:name="com.aldef.power.RebootAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- Mode Admin (Device Owner): untuk menyembunyikan aplikasi, diset sekali via ADB -->
        <receiver
            android:name="com.aldef.power.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN" >
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />

            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Tombol di panel notifikasi (Quick Settings) -->
        <service
            android:name="com.aldef.power.RestartTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_restart"
            android:label="@string/tile_restart"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name="com.aldef.power.LockTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_lock"
            android:label="@string/tile_lock"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" >
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>

</manifest>