<?xml version="1.0" encoding="utf-8"?>
<!-- Tombol sekunder: kaca gelap dengan tepi cyan halus, ukuran sama dengan tombol utama -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#2E22D3FF">
    <item>
        <shape>
            <corners android:radius="24dp" />
            <gradient
                android:angle="0"
                android:endColor="#121633"
                android:startColor="#182046" />
            <stroke
                android:width="1dp"
                android:color="#3322D3FF" />
        </shape>
    </item>
</ripple>
