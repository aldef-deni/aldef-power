<?xml version="1.0" encoding="utf-8"?>
<!-- Latar layar: navy pekat dengan cahaya ungu lembut di atas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#00070815"
                android:gradientRadius="420dp"
                android:startColor="#3A2A1F6B"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
