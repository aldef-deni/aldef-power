<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="accent_cyan">#22D3FF</color>
    <color name="accent_light">#B79CFF</color>
    <color name="accent_orange">#FF8A2B</color>
    <color name="accent_violet">#8B5CFF</color>
    <color name="bg">#070815</color>
    <color name="brand">#D32F2F</color>
    <color name="card_end">#0F1127</color>
    <color name="card_start">#161936</color>
    <color name="card_stroke">#262A52</color>
    <color name="danger">#FF4D6D</color>
    <color name="lock">#455A64</color>
    <color name="ok">#2EE59D</color>
    <color name="power">#F57C00</color>
    <color name="text_muted">#5C6290</color>
    <color name="text_primary">#F4F5FF</color>
    <color name="text_secondary">#9AA0C8</color>
    <string name="accessibility_desc">Dipakai ALDEF POWER untuk membuka menu power (restart), mengunci layar, dan membuka menu Hide apps realme. Isi layar hanya dibaca sesaat ketika Anda membuka Hide apps dari ALDEF POWER.</string>
    <string name="app_name">ALDEF POWER</string>
    <string name="sc_lock">Kunci Layar</string>
    <string name="sc_power">Menu Power</string>
    <string name="sc_restart">Restart</string>
    <string name="tile_lock">Kunci Layar</string>
    <string name="tile_restart">Restart HP</string>
    <style name="Theme.AldefPower.Dialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">#171A38</item>
        <item name="android:colorAccent">@color/accent_light</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="android:backgroundDimAmount">0.7</item>
    </style>
    <style name="Theme.AldefPower.Main" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent_violet</item>
    </style>
    <style name="Theme.AldefPower.Splash" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Theme.AldefPower.Viewer" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <item name="android:colorAccent">@color/accent_violet</item>
    </style>
</resources>