<?xml version="1.0" encoding="utf-8"?>
<!-- Tekan lama ikon aplikasi untuk memunculkan shortcut ini -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_restart"
        android:shortcutId="restart"
        android:shortcutShortLabel="@string/sc_restart">
        <intent
            android:action="com.aldef.power.RESTART"
            android:targetClass="com.aldef.power.QuickActionActivity"
            android:targetPackage="com.aldef.power" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_sc_lock"
        android:shortcutId="lock"
        android:shortcutShortLabel="@string/sc_lock">
        <intent
            android:action="com.aldef.power.LOCK"
            android:targetClass="com.aldef.power.QuickActionActivity"
            android:targetPackage="com.aldef.power" />
    </shortcut>
</shortcuts>
